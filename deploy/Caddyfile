atlexpress.biz.id {
    root * /var/www/html/public

    encode zstd gzip

    # Satu versi URL: tanpa trailing slash.
    @trailingSlash path_regexp trailing ^(.+)/$
    redir @trailingSlash {re.trailing.1} permanent

    # Defense-in-depth: Tolak eksekusi PHP di direktori storage upload
    @phpInStorage {
        path /storage/*.php /storage/*.php[0-9] /storage/*.phar /storage/*.phtml
    }
    respond @phpInStorage 403

    @build path /build/*
    header @build Cache-Control "public, max-age=31536000, immutable"

    @static path /images/* /fonts/* /favicon.ico /favicon-*.png /apple-touch-icon.png /site.webmanifest
    header @static Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

    @uploads path /storage/*
    header @uploads Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

    @seo path /sitemap.xml /robots.txt
    header @seo Cache-Control "public, max-age=3600"

    @admin path /admin /admin/*
    header @admin {
        Cache-Control "no-store, private"
        X-Robots-Tag "noindex, nofollow"
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Cross-Origin-Resource-Policy "same-site"
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.instagram.com https://www.tiktok.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.google-analytics.com https://analytics.google.com https://*.googletagmanager.com https://www.instagram.com https://www.tiktok.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.instagram.com https://www.tiktok.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    }

    php_fastcgi app:9000
    file_server
}

# Redirect versi www ke domain utama agar tidak duplicate content.
www.atlexpress.biz.id {
    redir https://atlexpress.biz.id{uri} permanent
}
