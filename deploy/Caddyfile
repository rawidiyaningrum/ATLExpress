atlexpress.biz.id {
    root * /var/www/html/public

    encode gzip

    @build path /build/*
    header @build Cache-Control "public, max-age=31536000, immutable"

    @static path /images/* /favicon.ico
    header @static Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

    @seo path /sitemap.xml /robots.txt
    header @seo Cache-Control "public, max-age=3600"

    @admin path /admin/*
    header @admin Cache-Control "no-store, private"

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    php_fastcgi app:9000
    file_server
}
