APP_NAME="ATL Express"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=atlexpress
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.atlexpress.biz.id
MAIL_PORT=465
MAIL_USERNAME=admin@atlexpress.biz.id
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@atlexpress.biz.id"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS="admin@atlexpress.biz.id"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Generator Artikel AI (Gemini API) ---
# API key diambil dari Google AI Studio (aistudio.google.com/apikey).
# Credit Google One / Google Flow tidak berlaku untuk API ini.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT=90
AI_MAX_OUTPUT_TOKENS=3000
AI_TEMPERATURE=0.85
AI_THINKING_BUDGET=0
AI_RETRIES=2
AI_RETRY_DELAY_MS=3000

# Pengaman biaya (USD). Cap 0 = AI diblokir total.
AI_MONTHLY_CAP_USD=5
AI_RUN_CAP_USD=1
AI_MAX_ARTICLES_PER_RUN=50

# --- Pemantau Permintaan Kargo dari Threads ---
# Sumber: api (resmi Meta), scrape (fallback), auto (api lalu scrape).
# API resmi butuh App Review permission `threads_keyword_search` agar bisa
# mencari postingan publik. Tanpa approval, hasil hanya post milik akun sendiri.
THREADS_ENABLED=true
THREADS_SOURCE=auto
THREADS_API_BASE_URL=https://graph.threads.com/v1.0
THREADS_ACCESS_TOKEN=
THREADS_APP_SECRET=
THREADS_API_TIMEOUT=30
THREADS_API_RETRIES=2
THREADS_API_RETRY_DELAY_MS=1500

# Fallback scraping (rapuh & berisiko ToS): buka halaman
# {THREADS_SCRAPE_BASE_URL}/search?exact_match=false&q={keyword}&filter=recent
# lalu ekstrak hasilnya.
THREADS_SCRAPE_BASE_URL=https://www.threads.com
THREADS_SCRAPE_TIMEOUT=30
THREADS_SCRAPE_RETRIES=1
# User-Agent crawler agar Threads merender hasil pencarian di sisi server.
THREADS_SCRAPE_USER_AGENT="Mozilla/5.0 (compatible; Bingbot/2.0; +http://www.bing.com/bingbot.htm)"

# Kuota keyword_search Meta 2.200 query / 24 jam per user. Default lebih rendah.
THREADS_QUERY_CAP_PER_DAY=2000
THREADS_PER_KEYWORD_LIMIT=25
